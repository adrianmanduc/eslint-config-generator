{
  "packageName": "eslint-plugin-n",
  "version": "18.5.0",
  "rules": [
    {"name":"callback-return","description":"require `return` statements after callbacks","url":"https://github.com/eslint-community/eslint-plugin-n/blob/HEAD/docs/rules/callback-return.md","type":"suggestion","fixable":false,"deprecated":false,"typed":false,"hasOptions":true},
    {"name":"exports-style","description":"enforce either `module.exports` or `exports`","url":"https://github.com/eslint-community/eslint-plugin-n/blob/HEAD/docs/rules/exports-style.md","type":"suggestion","fixable":true,"deprecated":false,"typed":false,"hasOptions":true},
