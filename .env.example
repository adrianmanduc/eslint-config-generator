# Copy this file to .env.local and fill in the values. Never commit .env.local.
# The app runs without any of these; they only tune metadata.

# Public (exposed to the browser)

# Public origin of the site, used for metadata, robots.txt and the sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:3150

# local | preview | production
NEXT_PUBLIC_APP_ENVIRONMENT=local
